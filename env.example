# Cheers — environment reference (v3 freelance platform, 2026-08-27)
# >>> Rename this file to `.env.example` (Claude cannot write dot-env paths). <<<
# Copy to .env and fill in. Every value marked OPTIONAL can stay unset and the
# app still runs: it is CASH-FIRST — online payments, SMS and push are layers
# that switch on when their keys appear.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/cheers?ssl=true
NEXTAUTH_URL=https://cheersja.com            # http://localhost:3000 in dev
NEXTAUTH_SECRET=                             # openssl rand -base64 32

# Sign-in: magic-link email (required) + Google (optional but recommended)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Cheers <no-reply@cheersja.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Address autocomplete, maps, ride distance (browser-exposed key, HTTP-referrer
# restricted to your domain in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Seed: `npm run db:seed` makes this address an admin (if the user exists)
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Marketplace levers
# ---------------------------------------------------------------------------
# Platform fee on gig bookings (percent of price + add-ons; tips excluded)
PLATFORM_FEE_PERCENT=5

# Launch mode: while this date is in the future, Cheers Membership — chat AND
# booking — is free for everyone. It is the only switch on the membership
# gate.
#
# WARNING: while Stripe is not configured this date is the ONLY thing granting
# access. The day it passes, every booking, quote request and job post stops
# platform-wide and no customer can pay to get through — there is no manual
# grant. Push the date forward before it lapses, or configure Stripe first.
# /admin and /admin/settings warn from 30 days out.
FREE_ACCESS_UNTIL=2026-12-31

# Cheers Membership price in cents once Stripe is live (default 500 = $5/month).
# Replaces CHAT_PASS_PRICE_CENTS, which is still read as a legacy fallback if
# this one is unset.
MEMBERSHIP_PRICE_CENTS=500

# ---------------------------------------------------------------------------
# Card payments — PowerTranz (First Atlantic Commerce)
# ---------------------------------------------------------------------------
# Stripe does not serve Jamaican merchants, and the platform is not permitted
# to collect a customer's money and pass it to a professional (that is money
# transmission, licensed by Bank of Jamaica). So CheersJA never touches job
# money: the customer pays the professional directly and the app records it.
#
# A card is only ever charged for CHEERSJA'S OWN revenue:
#   1. a customer's monthly membership, and
#   2. a professional's 5% commission, billed monthly in arrears.
#
# Everything works with none of this set: the app stays fully usable, no card
# UI renders, and billing simply never runs. Get credentials from your
# acquiring bank (NCB / Scotiabank / Sagicor) or from WiPay, who resell the
# same rails with much lighter onboarding.
POWERTRANZ_MERCHANT_ID=
POWERTRANZ_PASSWORD=
# API root, no trailing slash — the gateway's test and live hosts differ.
POWERTRANZ_BASE_URL=
# ISO 4217 NUMERIC code: 840 = USD, 388 = JMD. Not the letter code.
POWERTRANZ_CURRENCY_CODE=840
# Amount authorised (then immediately voided) when storing a card. 0 works on
# gateways that allow zero-value account verification; if yours rejects it,
# set a small amount such as 100.
POWERTRANZ_SETUP_AMOUNT_CENTS=0

# --- Billing clock ---------------------------------------------------------
# runBilling() closes statements, charges cards and renews memberships. It is
# driven by an hourly authenticated POST — without this, statements never
# close and memberships never renew:
#   0 * * * * curl -fsS -X POST -H "Authorization: Bearer $BILLING_CRON_SECRET" \
#     https://cheersja.com/api/payments/billing
BILLING_CRON_SECRET=
# Days a failed commission statement may go unpaid before that professional's
# listings are paused (lib/workers.ts publicWorkerConditions).
FEE_GRACE_DAYS=7

# Ride fare guidance shown to riders (cents): suggested = base + per-km × km
RIDE_BASE_FARE_CENTS=300
RIDE_PER_KM_CENTS=150

# ---------------------------------------------------------------------------
# Stripe (OPTIONAL — dormant until set; app is fully cash-only without it)
# ---------------------------------------------------------------------------
# Needs a Stripe account on a US/UK/EEA/CA/CH business entity. Setting the
# secret key switches on card checkout, the Cheers Membership subscription and
# automatic refunds. Webhook endpoint: https://<domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired, invoice.paid,
#         customer.subscription.updated, customer.subscription.deleted,
#         charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Safety (OPTIONAL tuning — production defaults are right; leave unset)
# ---------------------------------------------------------------------------
# Escalation ladder shape. Default (unset) = unstaffed: worker's trusted
# contacts + owner paged first. Set "on" only once real safety monitors are
# rostered — restores the monitor-first ladder.
SAFETY_STAFFED_DESK=off

# Web Push (needed for one-tap check-ins & alerts on locked phones)
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:general@cheersja.com

# ---------------------------------------------------------------------------
# SMS — staff pages and trusted-contact alerts (OPTIONAL, stays dark unset)
# ---------------------------------------------------------------------------
# SMS is the rung of the escalation ladder that reaches a phone with the app
# closed and push unavailable. With nothing set below, the platform honestly
# delivers no texts: it never pretends. Two adapters ship, chosen here.
#
#   generic (default) — POSTs {"to","text"} as JSON with a bearer token.
#                       Only for a provider that speaks exactly that shape.
#   twilio            — the real-world choice for Jamaica.
SMS_PROVIDER=generic

# --- generic adapter: both must be set ---
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# --- Twilio adapter: set SMS_PROVIDER=twilio and all three below ---
# Where to get them:
#   1. Sign up at twilio.com/try-twilio (a trial account works; it can only
#      text numbers you have verified until you add a card).
#   2. Console home page → Account Info → Account SID and Auth Token.
#      The Auth Token is a live credential: it can send messages and spend
#      money. Server-side only; never NEXT_PUBLIC_, never in the browser.
#   3. Phone Numbers → Buy a number, with SMS capability. A US (+1) long code
#      is the cheapest and delivers to Jamaica fine. TWILIO_FROM_NUMBER must
#      be in E.164 — "+18005550123", not "800-555-0123".
#
# Roughly what it costs (Twilio list prices, check before you rely on them):
#   · the number itself      ~US$1.15 / month
#   · outbound SMS to Jamaica ~US$0.09 per segment (a safety text is 1–2)
#   · inbound                 free, and unused — the platform never reads replies
# An escalation texting three people costs a few US cents. Budget for the
# monthly number rental, not the traffic.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PHASE TWO — WhatsApp Business, on this same Twilio account.
# More Jamaicans read WhatsApp than SMS, it is free to the recipient on most
# plans, and it delivers over data when a phone has no credit. Twilio's
# WhatsApp channel reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN — the changes
# are a WhatsApp-enabled sender ("whatsapp:+1…") and the fact that a
# business-initiated message must use a TEMPLATE Meta approved in advance
# (approval takes days, so the safety templates must be submitted long before
# they are needed at 3am). Freeform replies are only allowed inside a
# 24-hour window opened by the recipient. See docs/SAFETY-ARCHITECTURE.md.

# Demo/test knobs — compress the safety timers to watch escalation run in
# minutes. NEVER set in production.
# SAFETY_CHECKIN_MINUTES=2
# SAFETY_LADDER_SCALE=0.1
# SAFETY_SCHEDULER=off
